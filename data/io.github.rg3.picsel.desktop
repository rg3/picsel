[Desktop Entry]
Type=Application
Name=picsel
GenericName=Picture Selector
Comment=Choose which pictures of a folder to keep
Exec=picsel %f
Icon=io.github.rg3.picsel
Terminal=false
StartupNotify=true
SingleMainWindow=true
Categories=Graphics;Photography;Viewer;Qt;
MimeType=image/jpeg;video/mp4;video/quicktime;video/x-m4v;
Keywords=photo;picture;select;cull;gallery;
