[Desktop Entry]
Type=Application
Name=picsel
GenericName=Picture Selector
Comment=Choose which pictures of a folder to keep
Exec=picsel %f
# Absolute path: works even before the desktop has (re)scanned icon
# folders created by the install (e.g. a new ~/.local/share/icons/hicolor).
Icon=@PICSEL_ICON_PATH@
Terminal=false
StartupNotify=true
SingleMainWindow=true
Categories=Graphics;Photography;Viewer;Qt;
MimeType=image/jpeg;video/mp4;video/quicktime;inode/directory;
Keywords=photo;picture;select;cull;gallery;
